{
  "version": 2,
  "builds": [
    {
      "src": "app_web.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app_web.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/recordatorios",
      "schedule": "0 15 * * *"
    }
  ]
}
